# Copia este archivo como ".env" antes de correr el proyecto
# (en VS Code: clic derecho sobre .env.example -> "Copy", luego pega y renombra a ".env")

PORT=4000

# Cambia esto por una cadena larga y aleatoria en un entorno real.
# Aquí sirve solo para el prototipo académico.
JWT_SECRET=clave-secreta-de-desarrollo-cambiar-en-produccion
JWT_EXPIRES_IN=8h

# Días hábiles que tiene el estudiante para subsanar observaciones
DIAS_PLAZO_SUBSANACION=5

# Días hábiles totales que tiene la comisión para evaluar un expediente
DIAS_PLAZO_EVALUACION=15
